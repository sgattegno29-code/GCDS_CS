        elif move == 5: board[1][1] = player
        elif move == 6: board[1][2] = player
        elif move == 7: board[2][0] = player
        elif move == 8: board[2][1] = player
        elif move == 9: board[2][2] = player

        display_board(board)
                
        result = check_winner(board)

        if result == "x":
            print(f'{name1} wins!')
            break
            
        elif result == "o":
            print(f'{name2} wins!')
            break
            
        turn = turn + 1
        if turn == 9:
             print("It is a tie")
        else:
            if player == "x":
                  player = "o"
                  player_name = name2
            else:
                player = "x"
                player_name = name1
main()
